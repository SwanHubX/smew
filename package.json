{
  "name": "smew",
  "version": "0.1.0",
  "description": "Line chart smoothing library (TWE / RA / GS) with a Rust WASM implementation and an identical pure-TS fallback",
  "keywords": [
    "smoothing",
    "chart",
    "line-chart",
    "wasm",
    "rust",
    "timeseries",
    "visualization"
  ],
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwanHubX/smew.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "tsc -p tsconfig.types.json",
    "build:wasm": "wasm-pack build --target web && node scripts/inline-wasm.mjs",
    "prepublishOnly": "npm run build:wasm && npm run build:types && npm run build",
    "bench": "node bench/bench.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
